<view class="medical-page"><view class="medical-banner"><view class="banner-content"><text class="banner-title">校医预约</text><text class="banner-subtitle">方便快捷的校园医疗服务</text></view></view><view class="nav-tabs"><block wx:for="{{tabs}}" wx:for-item="tab" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['switchTab',[index]]]]]}}" class="{{['tab-item',(currentTab===index)?'active':'']}}" bindtap="__e"><text>{{tab}}</text></view></block></view><block wx:if="{{currentTab===0}}"><view class="tab-content"><view class="section-departments"><view class="section-title"><text>选择科室</text></view><view class="departments-list"><block wx:for="{{departments}}" wx:for-item="dept" wx:for-index="__i0__" wx:key="number"><view data-event-opts="{{[['tap',[['selectDepartment',['$0'],[[['departments','number',dept.number]]]]]]]}}" class="{{['department-item',(selectedDepartment&&selectedDepartment.number===dept.number)?'active':'']}}" bindtap="__e"><text>{{dept.name}}</text></view></block></view></view><block wx:if="{{selectedDepartment}}"><view class="section-date"><view class="section-title"><text>选择日期</text></view><view class="date-selector"><view class="dates"><block wx:for="{{availableDates}}" wx:for-item="date" wx:for-index="dateIndex" wx:key="dateIndex"><view data-event-opts="{{[['tap',[['selectDate',['$0'],[[['availableDates','',dateIndex]]]]]]]}}" class="{{['date-item',(selectedDate&&selectedDate.fullDate===date.fullDate)?'active':'']}}" bindtap="__e"><text class="date-day">{{date.day}}</text><text class="date-weekday">{{date.weekday}}</text></view></block></view></view></view></block><block wx:if="{{selectedDate}}"><view class="section-doctors"><view class="section-title"><text>选择医生</text></view><block wx:if="{{isLoadingDoctors}}"><view class="loading-state"><uni-load-more vue-id="1e71c44e-1" status="loading" contentText bind:__l="__l"></uni-load-more></view></block><block wx:else><block wx:if="{{$root.g0===0}}"><view class="empty-state small"><text class="empty-text">该科室今日无排班医生</text></view></block><block wx:else><view class="doctors-list"><block wx:for="{{doctorsList}}" wx:for-item="doctor" wx:for-index="__i1__" wx:key="id"><view class="doctor-card"><image class="doctor-avatar" src="{{doctor.avatar}}" mode="aspectFill"></image><view class="doctor-info"><view class="doctor-header"><text class="doctor-name">{{doctor.name}}</text><text class="doctor-title">{{doctor.title}}</text></view><view class="doctor-specialty-list"><text>{{"擅长："+doctor.specialty}}</text></view><view class="doctor-rating"><view class="stars"><block wx:for="{{5}}" wx:for-item="n" wx:for-index="__i2__" wx:key="*this"><text class="{{['star',(n<=doctor.rating)?'active':'']}}">★</text></block></view><text class="rating-text">{{doctor.ratingCount+"人评价"}}</text></view></view><button data-event-opts="{{[['tap',[['showDoctorDetail',['$0'],[[['doctorsList','id',doctor.id]]]]]]]}}" class="book-btn-list" bindtap="__e">预约</button></view></block></view></block></block></view></block></view></block><block wx:if="{{currentTab===1}}"><view class="tab-content"><view class="my-appointments"><view class="appointment-status-tabs"><block wx:for="{{appointmentStatusList}}" wx:for-item="status" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['switchStatusTab',[index]]]]]}}" class="{{['status-tab',(currentStatusTab===index)?'active':'']}}" bindtap="__e"><text>{{status}}</text></view></block></view><block wx:if="{{isLoadingAppointments}}"><view class="loading-state"><uni-load-more vue-id="1e71c44e-2" status="loading" contentText bind:__l="__l"></uni-load-more></view></block><block wx:else><block wx:if="{{$root.g1>0}}"><view class="appointment-list"><block wx:for="{{filteredAppointments}}" wx:for-item="appointment" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['viewAppointmentDetail',['$0'],[[['filteredAppointments','',index]]]]]]]}}" class="appointment-card" bindtap="__e"><view class="appointment-info"><text class="appointment-dept">{{appointment.department}}</text><text class="appointment-doctor">{{appointment.doctorName+" "+appointment.doctorTitle}}</text><view class="appointment-time"><image src="/static/images/calendar.png" mode="aspectFit"></image><text>{{appointment.date+" "+appointment.time}}</text></view><view class="appointment-location"><image src="/static/images/location.png" mode="aspectFit"></image><text>{{appointment.location}}</text></view></view><view class="appointment-action"><view class="{{['appointment-status',appointment.statusClass]}}"><text>{{appointment.status}}</text></view><block wx:if="{{appointment.status==='待就诊'}}"><button data-event-opts="{{[['tap',[['cancelAppointment',['$0'],[[['filteredAppointments','',index]]]]]]]}}" class="action-btn" catchtap="__e">取消预约</button></block></view></view></block></view></block><block wx:else><view class="empty-state"><image class="empty-image" src="/static/images/empty-appointments.png" mode="aspectFit"></image><text class="empty-text">{{"暂无"+appointmentStatusList[currentStatusTab]+"的预约记录"}}</text></view></block></block></view></view></block><block wx:if="{{currentTab===2}}"><view class="tab-content"><view class="health-records"><view class="records-type-tabs"><block wx:for="{{healthRecordTypes}}" wx:for-item="type" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['switchRecordType',[index]]]]]}}" class="{{['record-type',(currentRecordType===index)?'active':'']}}" bindtap="__e"><image src="{{type.icon}}" mode="aspectFit"></image><text>{{type.name}}</text></view></block></view><block wx:if="{{currentRecordType===0}}"><view class="records-list"><block wx:if="{{isLoadingMedicalRecords}}"><view class="loading-state"><uni-load-more vue-id="1e71c44e-3" status="loading" contentText bind:__l="__l"></uni-load-more></view></block><block wx:else><block wx:if="{{$root.g2>0}}"><view class="timeline"><block wx:for="{{medicalRecords}}" wx:for-item="record" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['viewRecordDetail',['$0'],[[['medicalRecords','',index]]]]]]]}}" class="timeline-item" bindtap="__e"><view class="timeline-dot"></view><view class="timeline-content"><view class="record-header"><text class="record-title">{{record.disease}}</text><text class="record-date">{{record.date}}</text></view><text class="record-doctor">{{record.doctorName+" "+record.doctorTitle}}</text><text class="record-desc">{{record.description}}</text></view></view></block></view></block><block wx:else><view class="empty-state"><image class="empty-image" src="/static/images/empty-reports.png" mode="aspectFit"></image><text class="empty-text">暂无就诊记录</text></view></block></block></view></block><block wx:if="{{currentRecordType===1}}"><view class="records-list"><block wx:if="{{$root.g3>0}}"><view><block wx:for="{{examReports}}" wx:for-item="report" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['viewExamReport',['$0'],[[['examReports','',index]]]]]]]}}" class="report-card" bindtap="__e"><view class="report-header"><text class="report-title">{{report.title}}</text><text class="report-date">{{report.date}}</text></view><view class="report-summary"><text class="summary-label">体检结论：</text><text class="summary-content">{{report.summary}}</text></view><view class="report-footer"><text class="report-location">{{report.location}}</text><view class="{{['report-status',report.statusClass]}}"><text>{{report.status}}</text></view></view></view></block></view></block><block wx:else><view class="empty-state"><image class="empty-image" src="/static/images/empty-reports.png" mode="aspectFit"></image><text class="empty-text">暂无体检报告</text></view></block></view></block><block wx:if="{{currentRecordType===2}}"><view class="records-list"><block wx:if="{{$root.g4>0}}"><view><block wx:for="{{vaccineRecords}}" wx:for-item="vaccine" wx:for-index="index" wx:key="index"><view class="vaccine-card"><view class="vaccine-header"><text class="vaccine-name">{{vaccine.name}}</text><view class="{{['vaccine-status',vaccine.statusClass]}}"><text>{{vaccine.status}}</text></view></view><view class="vaccine-info"><view class="vaccine-item"><text class="item-label">接种日期：</text><text class="item-value">{{vaccine.date||'未接种'}}</text></view><view class="vaccine-item"><text class="item-label">接种地点：</text><text class="item-value">{{vaccine.location||'未接种'}}</text></view><view class="vaccine-item"><text class="item-label">疫苗批次：</text><text class="item-value">{{vaccine.batch||'未接种'}}</text></view></view><block wx:if="{{vaccine.status==='未接种'}}"><button data-event-opts="{{[['tap',[['reserveVaccine',['$0'],[[['vaccineRecords','',index]]]]]]]}}" class="vaccine-btn" bindtap="__e">预约接种</button></block></view></block></view></block><block wx:else><view class="empty-state"><image class="empty-image" src="/static/images/empty-reports.png" mode="aspectFit"></image><text class="empty-text">暂无疫苗接种记录</text></view></block></view></block></view></view></block><block wx:if="{{showDoctorDetailPopup}}"><view class="doctor-detail-popup"><view data-event-opts="{{[['tap',[['hideDoctorDetail',['$event']]]]]}}" class="popup-mask" bindtap="__e"></view><view class="popup-content"><view class="popup-header"><text class="popup-title">预约详情</text><view data-event-opts="{{[['tap',[['hideDoctorDetail',['$event']]]]]}}" class="popup-close" bindtap="__e"><image src="/static/images/close.png" mode="aspectFit"></image></view></view><scroll-view class="popup-body" scroll-y="true"><view class="doctor-profile-popup"><image class="profile-avatar" src="{{currentDoctor.avatar}}" mode="aspectFill"></image><view class="profile-basic"><text class="profile-name">{{currentDoctor.name}}</text><text class="profile-title">{{currentDoctor.title}}</text><view class="profile-rating"><view class="stars"><block wx:for="{{5}}" wx:for-item="n" wx:for-index="__i3__" wx:key="*this"><text class="{{['star',(n<=currentDoctor.rating)?'active':'']}}">★</text></block></view><text class="rating-value">{{currentDoctor.rating}}</text></view></view></view><view class="profile-detail"><view class="detail-item"><text class="detail-label">专业擅长</text><text class="detail-value">{{currentDoctor.specialty}}</text></view><view class="detail-item"><text class="detail-label">{{"可预约时段 ("+(selectedDate?selectedDate.fullDate:'')+")"}}</text><view class="time-grid"><block wx:if="{{currentDoctor.isLoadingSlots}}"><view class="loading-state mini"><text class="loading-text">号源加载中...</text></view></block><block wx:else><block wx:if="{{$root.g5}}"><view class="slots-wrapper"><block wx:for="{{$root.l0}}" wx:for-item="slot" wx:for-index="slotIndex" wx:key="slotIndex"><view data-event-opts="{{[['tap',[['selectSlotInPopup',['$0'],[[['currentDoctor.availableSlots','',slotIndex]]]]]]]}}" class="time-block" bindtap="__e"><text class="{{[(slot.m0)?'selected':'']}}">{{slot.$orig}}</text></view></block></view></block><block wx:else><view class="no-slots"><text>暂无号源</text></view></block></block></view></view></view><button class="{{['book-button',(!selectedTimeInPopup)?'disabled':'']}}" disabled="{{!selectedTimeInPopup}}" data-event-opts="{{[['tap',[['submitAppointment',['$event']]]]]}}" bindtap="__e">确认预约</button></scroll-view></view></view></block><block wx:if="{{showAppointmentSuccess}}"><view class="modal appointment-success"><view data-event-opts="{{[['tap',[['hideAppointmentSuccess',['$event']]]]]}}" class="modal-mask" bindtap="__e"></view><view class="modal-content"><image class="success-icon" src="/static/images/success.png" mode="aspectFit"></image><text class="success-title">预约成功</text><view class="success-info"><view class="info-item"><text class="info-label">就诊科室：</text><text class="info-value">{{appointmentResult.department}}</text></view><view class="info-item"><text class="info-label">就诊医生：</text><text class="info-value">{{appointmentResult.doctorName}}</text></view><view class="info-item"><text class="info-label">就诊时间：</text><text class="info-value">{{appointmentResult.date+" "+appointmentResult.time}}</text></view><view class="info-item"><text class="info-label">就诊地点：</text><text class="info-value">{{appointmentResult.location}}</text></view></view><view class="success-reminder"><text>请于预约时间前十分钟左右，携带校园卡或身份证到诊室门口等待叫号。</text></view><view class="success-actions"><view data-event-opts="{{[['tap',[['hideAppointmentSuccess',['$event']]]]]}}" class="action-btn primary" bindtap="__e">完成</view></view></view></view></block><block wx:if="{{showAppointmentDetail}}"><view class="modal appointment-detail"><view data-event-opts="{{[['tap',[['hideAppointmentDetail',['$event']]]]]}}" class="modal-mask" bindtap="__e"></view><view class="modal-content"><view class="modal-header"><text class="modal-title">预约详情</text><view data-event-opts="{{[['tap',[['hideAppointmentDetail',['$event']]]]]}}" class="modal-close" bindtap="__e"><image src="/static/images/close.png" mode="aspectFit"></image></view></view><view class="detail-content"><view class="{{['detail-status',currentAppointmentStatusClass]}}"><text>{{currentAppointment.status}}</text></view><view class="detail-item"><text class="detail-label">就诊科室：</text><text class="detail-value">{{currentAppointment.department}}</text></view><view class="detail-item"><text class="detail-label">就诊医生：</text><text class="detail-value">{{currentAppointment.doctorName+" "+currentAppointment.doctorTitle}}</text></view><view class="detail-item"><text class="detail-label">就诊时间：</text><text class="detail-value">{{currentAppointment.date+" "+currentAppointment.time}}</text></view><view class="detail-item"><text class="detail-label">就诊地点：</text><text class="detail-value">{{currentAppointment.location}}</text></view><block wx:if="{{currentAppointment.status==='待就诊'}}"><view class="detail-actions"><button data-event-opts="{{[['tap',[['confirmCancelAppointment',['$event']]]]]}}" class="action-btn" bindtap="__e">取消预约</button></view></block></view></view></view></block><block wx:if="{{showMedicalRecordDetail}}"><view class="modal medical-record-detail"><view data-event-opts="{{[['tap',[['hideMedicalRecordDetail',['$event']]]]]}}" class="modal-mask" bindtap="__e"></view><view class="modal-content"><view class="modal-header"><text class="modal-title">就诊记录详情</text><view data-event-opts="{{[['tap',[['hideMedicalRecordDetail',['$event']]]]]}}" class="modal-close" bindtap="__e"><image src="/static/images/close.png" mode="aspectFit"></image></view></view><block wx:if="{{isLoadingRecordDetail}}"><view class="detail-content"><view class="loading-state"><uni-load-more vue-id="1e71c44e-4" status="loading" bind:__l="__l"></uni-load-more></view></view></block><block wx:else><block wx:if="{{currentMedicalRecord.billno}}"><scroll-view class="detail-scroll-view" scroll-y="true"><view class="detail-content"><view class="detail-item"><text class="detail-label">诊断结果：</text><text class="detail-value bold">{{currentMedicalRecord.lb77_diagnosis}}</text></view><view class="detail-item"><text class="detail-label">就诊医生：</text><text class="detail-value">{{currentMedicalRecord.lb77_doctor_name+"\n\t\t\t\t\t\t\t"+currentMedicalRecord.lb77_doctor_lb77_title}}</text></view><view class="detail-item"><text class="detail-label">就诊日期：</text><text class="detail-value">{{$root.g6[0]}}</text></view><view class="detail-item advice-item"><text class="detail-label">医嘱：</text><text class="detail-value advice">{{currentMedicalRecord.lb77_advice||'无'}}</text></view><view class="prescription-section"><view class="section-title"><text>药品处方</text></view><block wx:if="{{$root.g7}}"><view class="prescription-list"><block wx:for="{{currentMedicalRecord.entryentity}}" wx:for-item="med" wx:for-index="index" wx:key="index"><view class="prescription-item"><view class="med-header"><text class="med-name">{{med.lb77_medicine_name}}</text><text class="med-spec">{{med.lb77_medicine_lb77_specification+"\n\t\t\t\t\t\t\t\t\t\t("+med.lb77_medicine_lb77_dosage_form+")"}}</text></view><text class="med-usage">{{"用法："+med.lb77_usage}}</text><text class="med-quantity">{{"数量："+med.lb77_quantity+" "+med.lb77_unit_name}}</text></view></block></view></block><block wx:else><view class="empty-prescription"><text>本次就诊无处方药品</text></view></block></view></view></scroll-view></block></block></view></view></block></view>