<view class="psych-assessment-page"><view class="assessment-banner"><image class="banner-image" src="/static/images/psychology-banner.png" mode="aspectFill"></image><view class="banner-content"><text class="banner-title">心理健康评估</text><text class="banner-subtitle">关爱自己，从了解开始</text></view></view><view class="assessment-container"><view class="tabs"><block wx:for="{{tabs}}" wx:for-item="tab" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['switchTab',[index]]]]]}}" class="{{['tab-item',(currentTab===index)?'active':'']}}" bindtap="__e"><text>{{tab}}</text></view></block></view><block wx:if="{{currentTab===0}}"><view><view class="assessment-content"><block wx:if="{{assessmentStep==='list'}}"><view><view class="questionnaire-list"><block wx:for="{{questionnaireList}}" wx:for-item="q" wx:for-index="__i0__" wx:key="id"><view data-event-opts="{{[['tap',[['startAssessment',['$0'],[[['questionnaireList','id',q.id]]]]]]]}}" class="questionnaire-card" bindtap="__e"><image class="q-card-icon" src="{{q.icon}}" mode="aspectFit"></image><view class="q-card-info"><text class="q-card-title">{{q.title}}</text><text class="q-card-desc">{{q.description}}</text></view><button class="start-btn">开始评估</button></view></block></view></view></block><block wx:if="{{assessmentStep==='answering'}}"><view><view class="question-list"><block wx:for="{{$root.l1}}" wx:for-item="question" wx:for-index="index" wx:key="index"><view class="question-item"><view class="question-title">{{index+1+". "+question.$orig.text}}</view><radio-group data-event-opts="{{[['change',[['handleRadioChange',['$event',index]]]]]}}" bindchange="__e"><block wx:for="{{question.l0}}" wx:for-item="option" wx:for-index="oIndex" wx:key="oIndex"><label class="option-item"><view class="option-text"><radio value="{{option.m0}}" checked="{{question.$orig.selected===oIndex}}"></radio><text>{{option.$orig.text}}</text></view></label></block></radio-group></view></block></view><button class="submit-button" disabled="{{!isAllQuestionsAnswered}}" data-event-opts="{{[['tap',[['submitAssessment',['$event']]]]]}}" bindtap="__e">提交问卷</button></view></block><block wx:if="{{assessmentStep==='report'}}"><view><view class="report-card"><view class="report-title">您的心理健康评估报告</view><view class="report-item"><text class="report-label">评估结果：</text><text class="report-value result-level">{{assessmentReport.level}}</text></view><view class="report-item"><text class="report-label">总得分：</text><text class="report-value">{{assessmentReport.score}}</text></view><view class="report-item"><text class="report-label">评估建议：</text><text class="report-value">{{assessmentReport.suggestion}}</text></view><button data-event-opts="{{[['tap',[['resetAssessment',['$event']]]]]}}" class="retest-button" bindtap="__e">重新评估</button></view></view></block></view></view></block><block wx:if="{{currentTab===1}}"><view><view class="counseling-section"><view class="section-title"><text>咨询师预约</text></view><block wx:if="{{isLoadingCounselors}}"><view class="loading-state"><uni-load-more vue-id="b6ea3a3a-1" status="loading" bind:__l="__l"></uni-load-more></view></block><block wx:else><view class="counselor-list"><block wx:for="{{$root.l2}}" wx:for-item="counselor" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['showCounselorDetail',['$0'],[[['counselors','',index]]]]]]]}}" class="counselor-card" bindtap="__e"><image class="counselor-avatar" src="{{counselor.$orig.avatar}}" mode="aspectFill"></image><view class="counselor-info"><view class="counselor-header"><text class="counselor-name">{{counselor.$orig.name}}</text><text class="counselor-title">{{counselor.$orig.title}}</text></view><view class="counselor-specialties"><text class="specialty-label">专长：</text><view class="specialty-tags"><block wx:for="{{counselor.$orig.specialties}}" wx:for-item="tag" wx:for-index="tagIndex" wx:key="tagIndex"><text class="specialty-tag">{{tag}}</text></block></view></view><view class="counselor-rating"><view class="stars"><block wx:for="{{5}}" wx:for-item="n" wx:for-index="__i1__" wx:key="*this"><text class="{{['star',(n<=counselor.$orig.rating)?'active':'']}}">★</text></block></view><text class="rating-value">{{counselor.g0}}</text><text class="rating-count">{{"("+counselor.$orig.ratingCount+")"}}</text></view></view><button class="book-btn">预约</button></view></block></view></block></view></view></block><block wx:if="{{currentTab===2}}"><view><view class="my-records-section"><uni-segmented-control vue-id="b6ea3a3a-2" current="{{recordsTab}}" values="{{['评估报告','咨询预约']}}" style-type="button" active-color="#007AFF" data-event-opts="{{[['^clickItem',[['onRecordsTabClick']]]]}}" bind:clickItem="__e" bind:__l="__l"></uni-segmented-control><view class="records-content"><block wx:if="{{recordsTab===0}}"><view><block wx:if="{{isLoadingReports}}"><view class="loading-state"><uni-load-more vue-id="b6ea3a3a-3" status="loading" contentText="报告加载中..." bind:__l="__l"></uni-load-more></view></block><block wx:else><block wx:if="{{$root.g1===0}}"><view class="empty-state"><image class="empty-image" src="/static/images/empty-box.png" mode="aspectFit"></image><text class="empty-text">您还没有评估报告</text><button data-event-opts="{{[['tap',[['switchTab',[0]]]]]}}" class="primary-btn" bindtap="__e">立即评估</button></view></block><block wx:else><view class="report-list"><block wx:for="{{$root.l3}}" wx:for-item="report" wx:for-index="__i2__" wx:key="id"><view class="my-report-card"><view class="my-report-header"><text class="my-report-title">{{report.$orig.lb77_questionnairetitle}}</text><text class="my-report-date">{{report.m1}}</text></view><view class="my-report-body"><view class="my-report-item"><text class="my-report-label">评估结果</text><text class="my-report-value result">{{report.$orig.lb77_resultsummary}}</text></view><view class="my-report-item"><text class="my-report-label">总得分</text><text class="my-report-value score">{{report.$orig.lb77_totalscore}}</text></view></view></view></block></view></block></block></view></block><block wx:if="{{recordsTab===1}}"><view><block wx:if="{{isLoadingAppointments}}"><view class="loading-state"><uni-load-more vue-id="b6ea3a3a-4" status="loading" contentText="预约加载中..." bind:__l="__l"></uni-load-more></view></block><block wx:else><block wx:if="{{$root.g2===0}}"><view class="empty-state"><image class="empty-image" src="/static/images/empty-box.png" mode="aspectFit"></image><text class="empty-text">您还没有咨询预约</text><button data-event-opts="{{[['tap',[['switchTab',[1]]]]]}}" class="primary-btn" bindtap="__e">立即预约</button></view></block><block wx:else><view class="appointment-list"><block wx:for="{{$root.l4}}" wx:for-item="apt" wx:for-index="__i3__" wx:key="id"><view class="appointment-card"><view class="apt-header"><text class="apt-counselor">{{apt.$orig.lb77_counselor_name}}</text><text class="{{['apt-status',apt.$orig.statusClass]}}">{{apt.$orig.lb77_appointment_status}}</text></view><view class="apt-body"><text class="apt-time">{{"时间："+apt.m2+" "+apt.m3}}</text></view><block wx:if="{{apt.$orig.lb77_appointment_status==='已预约'}}"><view class="apt-footer"><button data-event-opts="{{[['tap',[['confirmCancelAppointment',['$0'],[[['processedAppointments','id',apt.$orig.id,'id']]]]]]]}}" class="cancel-btn" bindtap="__e">取消预约</button></view></block></view></block></view></block></block></view></block></view></view></view></block></view><block wx:if="{{showCounselorDetailPopup}}"><view class="counselor-detail-popup"><view data-event-opts="{{[['tap',[['hideCounselorDetail',['$event']]]]]}}" class="popup-mask" bindtap="__e"></view><view class="popup-content"><view class="popup-header"><text class="popup-title">咨询师详情</text><view data-event-opts="{{[['tap',[['hideCounselorDetail',['$event']]]]]}}" class="popup-close" bindtap="__e"><image src="/static/images/close.png" mode="aspectFit"></image></view></view><view class="popup-body"><view class="counselor-profile"><image class="profile-avatar" src="{{currentCounselor.avatar}}" mode="aspectFill"></image><view class="profile-basic"><text class="profile-name">{{currentCounselor.name}}</text><text class="profile-title">{{currentCounselor.title}}</text><view class="profile-rating"><view class="stars"><block wx:for="{{5}}" wx:for-item="n" wx:for-index="__i4__" wx:key="*this"><text class="{{['star',(n<=currentCounselor.rating)?'active':'']}}">★</text></block></view><text class="rating-value">{{$root.g3}}</text></view></view></view><view class="profile-detail"><view class="detail-item"><text class="detail-label">专业背景</text><text class="detail-value">{{currentCounselor.background}}</text></view><view class="detail-item"><text class="detail-label">咨询专长</text><view class="specialty-tags"><block wx:for="{{currentCounselor.specialties}}" wx:for-item="tag" wx:for-index="tagIndex" wx:key="tagIndex"><text class="specialty-tag">{{tag}}</text></block></view></view><view class="detail-item"><text class="detail-label">咨询风格</text><text class="detail-value">{{currentCounselor.style}}</text></view><view class="detail-item"><text class="detail-label">可预约时段</text><view class="time-slots"><view class="date-selector"><view class="dates"><block wx:for="{{availableDates}}" wx:for-item="date" wx:for-index="dateIndex" wx:key="dateIndex"><view data-event-opts="{{[['tap',[['selectDate',[dateIndex]]]]]}}" class="{{['date-item',(selectedDateIndex===dateIndex)?'active':'']}}" bindtap="__e"><text class="date-day">{{date.day}}</text><text class="date-weekday">{{date.weekday}}</text></view></block></view></view><block wx:if="{{isLoadingSchedule}}"><view class="loading-state"><uni-load-more vue-id="b6ea3a3a-5" status="loading" contentText="号源加载中..." bind:__l="__l"></uni-load-more></view></block><block wx:else><block wx:if="{{$root.g4===0}}"><view class="empty-slots"><text>暂无号源</text></view></block><block wx:else><view class="time-grid"><block wx:for="{{availableTimeSlots}}" wx:for-item="time" wx:for-index="timeIndex" wx:key="timeIndex"><view data-event-opts="{{[['tap',[['selectTime',['$0'],[[['availableTimeSlots','',timeIndex]]]]]]]}}" class="{{['time-block',(time.available)?'available':'',(selectedTime.startTime===time.startTime&&time.available)?'selected':'']}}" bindtap="__e"><text>{{time.time}}</text></view></block></view></block></block></view></view></view><button class="{{['book-button',(!selectedTime.startTime)?'disabled':'']}}" disabled="{{!selectedTime.startTime}}" data-event-opts="{{[['tap',[['bookAppointment',['$event']]]]]}}" bindtap="__e">确认预约</button></view></view></view></block></view>