	flex-shrink: 0;
}

/* 预约详情弹窗 */
.apt-detail-popup {
	position: fixed;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	z-index: 999;
}
.apt-detail-body {
	padding: 30rpx;
}
.qrcode-section {
	display: flex;
	flex-direction: column;
	align-items: center;
	margin-bottom: 30rpx;
}
.qrcode-image {
	width: 360rpx;
	height: 360rpx;
}
.qrcode-tip {
	margin-top: 12rpx;
	font-size: 24rpx;
	color: #666;
}
.apt-info {
	background-color: #fff;
	border-radius: 16rpx;
	padding: 20rpx;
	box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}
.info-row {
	display: flex;
	justify-content: space-between;
	padding: 12rpx 0;
}
.info-label {
	color: #666;
	font-size: 26rpx;
}
.info-value {
	color: #333;
	font-size: 28rpx;
	font-weight: 500;
}

