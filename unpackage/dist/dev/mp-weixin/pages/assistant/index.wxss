.assistant-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f4f6f9;
}
.chat-container {
  flex: 1;
  overflow-y: auto;
  padding: 20rpx;
  box-sizing: border-box;
}
.chat-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}
.chat-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  max-width: 85%;
}
.chat-item .avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
}
.chat-item .avatar image {
  width: 100%;
  height: 100%;
}
.chat-item .message-bubble {
  padding: 20rpx 25rpx;
  border-radius: 20rpx;
  background-color: #ffffff;
  word-break: break-word;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}
.assistant-message {
  align-self: flex-start;
}
.assistant-message .message-bubble {
  background-color: #ffffff;
  border-top-left-radius: 0;
}
.user-message {
  align-self: flex-end;
  flex-direction: row-reverse;
}
.user-message .message-bubble {
  background-color: #4f80ff;
  color: #ffffff;
  border-top-right-radius: 0;
}
.input-area {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #ffffff;
  border-top: 1rpx solid #e0e0e0;
}
.input-area .text-input {
  flex: 1;
  height: 80rpx;
  padding: 0 20rpx;
  border-radius: 40rpx;
  background-color: #f4f6f9;
  margin-right: 20rpx;
}
.input-area .send-btn {
  height: 80rpx;
  line-height: 80rpx;
  background-color: #4f80ff;
  color: white;
  border-radius: 40rpx;
  padding: 0 40rpx;
  font-size: 28rpx;
}
.input-area .send-btn[disabled] {
  background-color: #a9c2ff;
}
.typing-indicator {
  display: flex;
  gap: 8rpx;
  align-items: center;
  padding: 10rpx 0;
}
.typing-indicator .dot {
  width: 16rpx;
  height: 16rpx;
  background-color: #b0c4de;
  border-radius: 50%;
  -webkit-animation: typing 1.4s infinite;
          animation: typing 1.4s infinite;
}
.typing-indicator .dot:nth-child(2) {
  -webkit-animation-delay: 0.2s;
          animation-delay: 0.2s;
}
.typing-indicator .dot:nth-child(3) {
  -webkit-animation-delay: 0.4s;
          animation-delay: 0.4s;
}
@-webkit-keyframes typing {
0%, 80%, 100% {
    -webkit-transform: scale(0.6);
            transform: scale(0.6);
    opacity: 0.5;
}
40% {
    -webkit-transform: scale(1);
            transform: scale(1);
    opacity: 1;
}
}
@keyframes typing {
0%, 80%, 100% {
    -webkit-transform: scale(0.6);
            transform: scale(0.6);
    opacity: 0.5;
}
40% {
    -webkit-transform: scale(1);
            transform: scale(1);
    opacity: 1;
}
}
.card-message .card-title {
  font-weight: bold;
  font-size: 32rpx;
  margin-bottom: 20rpx;
}
.card-message .card-body .card-item {
  margin-bottom: 10rpx;
}
.card-message .card-body .card-item .card-item-heading {
  font-weight: 500;
  color: #555;
  margin-bottom: 8rpx;
}
.card-message .card-body .card-item .card-item-field {
  display: flex;
}
.card-message .card-body .card-item .card-item-field .field-label {
  color: #888;
  margin-right: 10rpx;
  white-space: nowrap;
}
.card-message .card-body .card-item .card-item-field .field-value {
  color: #333;
}
.card-message .card-body .card-qrcode {
  width: 200rpx;
  height: 200rpx;
  margin: 20rpx auto 0;
  display: block;
}
.card-message .card-footer {
  margin-top: 20rpx;
  padding-top: 15rpx;
  border-top: 1rpx solid #eee;
  font-size: 26rpx;
  color: #888;
}
.card-message .card-buttons {
  margin-top: 20rpx;
}
.card-message .card-buttons .card-button {
  background-color: #4f80ff;
  color: white;
  font-size: 28rpx;
}
.rich-content-message .rich-title {
  font-weight: bold;
  font-size: 32rpx;
  margin-bottom: 15rpx;
}
.rich-content-message .rich-list {
  margin-bottom: 15rpx;
}
.rich-content-message .rich-list .rich-list-item {
  margin-bottom: 5rpx;
  font-size: 28rpx;
}
.rich-content-message .rich-image {
  width: 100%;
  border-radius: 10rpx;
  margin-bottom: 15rpx;
}
.rich-content-message .rich-suggestion {
  font-weight: 500;
  color: #2c3e50;
}
.parcel-message .parcel-title {
  font-weight: bold;
  font-size: 32rpx;
  margin-bottom: 20rpx;
}
.parcel-message .parcel-item {
  padding: 15rpx;
  border-radius: 10rpx;
  background-color: #f9f9f9;
  margin-bottom: 15rpx;
}
.parcel-message .parcel-item .parcel-item-title {
  font-weight: 500;
  margin-bottom: 8rpx;
}
.parcel-message .parcel-item .parcel-info {
  font-size: 26rpx;
  color: #555;
}
.parcel-message .parcel-item .parcel-code {
  font-weight: bold;
  color: #e67e22;
}
.list-message .list-title {
  font-weight: bold;
  font-size: 32rpx;
  margin-bottom: 15rpx;
}
.list-message .list-item {
  margin-bottom: 8rpx;
  font-size: 28rpx;
}
.is-link {
  cursor: pointer;
  transition: background-color 0.2s;
}
.is-link:hover {
  background-color: rgba(0, 0, 0, 0.05);
}
.card-message .card-body .card-item .card-item-field.is-link {
  padding: 10rpx;
  margin: -10rpx;
  border-radius: 8rpx;
}
.card-message .card-body .card-item .card-item-field.is-link .field-value {
  color: #4f80ff;
  text-decoration: underline;
}
.rich-content-message .rich-list-item.is-link {
  color: #4f80ff;
  padding: 10rpx;
  margin: -10rpx 0;
  border-radius: 8rpx;
}
.parcel-message .parcel-item.is-link {
  border: 1px solid transparent;
}
.parcel-message .parcel-item.is-link:hover {
  border-color: #4f80ff;
}
.list-message .list-item.is-link {
  color: #4f80ff;
  padding: 10rpx;
  margin: -10rpx;
  border-radius: 8rpx;
}
