.assistant-page.data-v-411d5278 {
	display: flex;
	flex-direction: column;
	height: 100vh;
	background-color: #f5f5f5;
	padding-bottom: env(safe-area-inset-bottom);
}
/* 快捷指令菜单样式 - 现在放在底部 */
.quick-access-menu.data-v-411d5278 {
	background-color: #ffffff;
	padding: 20rpx 0;
	border-top: 1rpx solid #e0e0e0;
	box-shadow: 0 -2rpx 6rpx rgba(0, 0, 0, 0.1);
	position: relative;
	z-index: 10;
}
.menu-scroll.data-v-411d5278 {
	white-space: nowrap;
	padding: 0 20rpx;
}
.menu-item.data-v-411d5278 {
	display: inline-block;
	text-align: center;
	margin-right: 30rpx;
	width: 120rpx;
}
.menu-icon.data-v-411d5278 {
	width: 80rpx;
	height: 80rpx;
	margin: 0 auto;
	background-color: #e6f2ff;
	border-radius: 50%;
	display: flex;
	justify-content: center;
	align-items: center;
}
.menu-icon image.data-v-411d5278 {
	width: 50rpx;
	height: 50rpx;
}
.menu-text.data-v-411d5278 {
	font-size: 24rpx;
	color: #333;
	margin-top: 10rpx;
}
/* 聊天窗口 */
.chat-container.data-v-411d5278 {
	flex: 1;
	padding: 20rpx;
	overflow-y: auto;
}
.chat-list.data-v-411d5278 {
	padding-bottom: 20rpx;
}
.chat-item.data-v-411d5278 {
	display: flex;
	margin-bottom: 30rpx;
}
.user-message.data-v-411d5278 {
	flex-direction: row-reverse;
}
.avatar.data-v-411d5278 {
	width: 80rpx;
	height: 80rpx;
	border-radius: 50%;
	overflow: hidden;
	flex-shrink: 0;
}
.avatar image.data-v-411d5278 {
	width: 100%;
	height: 100%;
}
.message-bubble.data-v-411d5278 {
	max-width: 70%;
	padding: 20rpx;
	border-radius: 20rpx;
	margin: 0 20rpx;
	word-break: break-all;
	background-color: #ffffff;
	box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}
.system-message .message-bubble.data-v-411d5278 {
	background-color: #E6F2FF;
	color: #333;
	border-top-left-radius: 0;
}
.user-message .message-bubble.data-v-411d5278 {
	background-color: #ffffff;
	color: #333333;
	border-top-right-radius: 0;
}
/* New Styles for Thinking Process */
.thinking-process-container.data-v-411d5278 {
	margin: 20rpx 0;
	padding: 20rpx;
	background-color: #ffffff;
	border-radius: 20rpx;
	box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}
.thinking-header.data-v-411d5278 {
	display: flex;
	align-items: center;
	margin-bottom: 20rpx;
}
.spinner.data-v-411d5278 {
	width: 32rpx;
	height: 32rpx;
	border: 4rpx solid #007AFF;
	border-top-color: transparent;
	border-radius: 50%;
	-webkit-animation: spin-data-v-411d5278 1s linear infinite;
	        animation: spin-data-v-411d5278 1s linear infinite;
	margin-right: 20rpx;
}
@-webkit-keyframes spin-data-v-411d5278 {
to {
		-webkit-transform: rotate(360deg);
		        transform: rotate(360deg);
}
}
@keyframes spin-data-v-411d5278 {
to {
		-webkit-transform: rotate(360deg);
		        transform: rotate(360deg);
}
}
.status-icon-completed.data-v-411d5278 {
	width: 40rpx;
	height: 40rpx;
	margin-right: 16rpx;
}
.thinking-title.data-v-411d5278 {
	font-size: 28rpx;
	font-weight: bold;
	color: #333;
}
.steps-list.data-v-411d5278 {
	display: flex;
	flex-direction: column;
	gap: 10rpx;
}
.step-item.data-v-411d5278 {
	background-color: #f8f8f8;
	border-radius: 15rpx;
	overflow: hidden;
}
.step-header.data-v-411d5278 {
	display: flex;
	align-items: center;
	padding: 20rpx;
	cursor: pointer;
}
.step-icon.data-v-411d5278 {
	width: 32rpx;
	height: 32rpx;
	margin-right: 16rpx;
	flex-shrink: 0;
}
.step-title.data-v-411d5278 {
	flex: 1;
	font-size: 26rpx;
	color: #555;
}
.arrow-icon.data-v-411d5278 {
	width: 30rpx;
	height: 30rpx;
	transition: -webkit-transform 0.2s ease-in-out;
	transition: transform 0.2s ease-in-out;
	transition: transform 0.2s ease-in-out, -webkit-transform 0.2s ease-in-out;
}
.arrow-icon.expanded.data-v-411d5278 {
	-webkit-transform: rotate(90deg);
	        transform: rotate(90deg);
}
.step-content.data-v-411d5278 {
	padding: 0 20rpx 20rpx 68rpx;
	background-color: #f8f8f8;
	font-size: 24rpx;
	color: #666;
	word-break: break-all;
}
.step-content ._pre.data-v-411d5278 {
	white-space: pre-wrap;
	font-family: 'Courier New', Courier, monospace;
	background-color: #efefef;
	padding: 15rpx;
	border-radius: 10rpx;
}
/* 任务面板 */
.task-panel.data-v-411d5278 {
	background-color: #ffffff;
	padding: 20rpx;
	border-top: 1rpx solid #e0e0e0;
	border-bottom: 1rpx solid #e0e0e0;
}
.panel-title.data-v-411d5278 {
	font-size: 28rpx;
	font-weight: bold;
 color: #333;
		margin-bottom: 20rpx;
}
.task-scroll.data-v-411d5278 {
		white-space: nowrap;
}
.task-card.data-v-411d5278 {
	display: inline-block;
	width: 450rpx;
		background-color: #ffffff;
		border-radius: 20rpx;
 padding: 20rpx;
		margin-right: 20rpx;
	box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
		position: relative;
}
.task-icon.data-v-411d5278 {
 width: 60rpx;
	height: 60rpx;
	position: absolute;
	top: 20rpx;
	left: 20rpx;
}
.task-icon image.data-v-411d5278 {
			width: 100%;
			height: 100%;
}
.task-info.data-v-411d5278 {
 margin-left: 80rpx;
}
.task-title.data-v-411d5278 {
 font-size: 28rpx;
	font-weight: bold;
 color: #333;
}
.task-desc.data-v-411d5278 {
		font-size: 24rpx;
 color: #666;
 margin: 10rpx 0;
}
.progress-bar.data-v-411d5278 {
	height: 10rpx;
	background-color: #f0f0f0;
	border-radius: 5rpx;
		overflow: hidden;
 margin: 10rpx 0;
}
.progress-fill.data-v-411d5278 {
		height: 100%;
 background-color: #007AFF;
}
.task-time.data-v-411d5278 {
	font-size: 24rpx;
		color: #999;
}
.task-status.data-v-411d5278 {
		position: absolute;
 top: 20rpx;
	right: 20rpx;
 padding: 5rpx 10rpx;
	border-radius: 10rpx;
		font-size: 22rpx;
}
.task-status.processing.data-v-411d5278 {
	background-color: #e6f2ff;
	color: #007AFF;
}
.task-status.ready.data-v-411d5278 {
	background-color: #e6fff2;
	color: #00B578;
}
.task-status.warning.data-v-411d5278 {
	background-color: #fff9e6;
	color: #FF9500;
}
/* 底部输入区域 */
.input-area.data-v-411d5278 {
	background-color: #ffffff;
	padding: 20rpx;
	border-top: 1rpx solid #e0e0e0;
	display: flex;
		align-items: center;
}
.mic-btn.data-v-411d5278, .attach-btn.data-v-411d5278, .send-btn.data-v-411d5278 {
	width: 60rpx;
	height: 60rpx;
		display: flex;
		justify-content: center;
		align-items: center;
}
.mic-btn image.data-v-411d5278, .attach-btn image.data-v-411d5278, .send-btn image.data-v-411d5278 {
	width: 40rpx;
	height: 40rpx;
}
.text-input.data-v-411d5278 {
	flex: 1;
	height: 70rpx;
	background-color: #f5f5f5;
	border-radius: 35rpx;
	padding: 0 20rpx;
	margin: 0 20rpx;
	font-size: 28rpx;
}
.link-style.data-v-411d5278 {
	color: #007AFF;
	text-decoration: underline;
	cursor: pointer;
}

