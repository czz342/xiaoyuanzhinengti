<view class="assistant-page"><scroll-view class="chat-container" scroll-y="true" scroll-into-view="{{lastMessageId}}" scroll-with-animation="{{true}}"><view class="chat-list"><block wx:for="{{chatMessages}}" wx:for-item="msg" wx:for-index="index" wx:key="index"><view class="{{['chat-item',(msg.role==='user')?'user-message':'',(msg.role==='assistant')?'assistant-message':'']}}" id="{{'msg-'+index}}"><view class="avatar"><image src="{{msg.role==='user'?userAvatar:botAvatar}}" mode="aspectFill"></image></view><view class="message-bubble"><block wx:if="{{msg.type==='text'}}"><text class="message-text">{{msg.payload.text}}</text></block><block wx:else><block wx:if="{{msg.type==='card'}}"><view class="card-message"><block wx:if="{{msg.payload.title}}"><view class="card-title">{{msg.payload.title}}</view></block><view class="card-body"><block wx:for="{{msg.payload.items}}" wx:for-item="item" wx:for-index="itemIndex" wx:key="itemIndex"><view class="card-item"><block wx:if="{{item.type==='heading'}}"><text class="card-item-heading">{{item.text}}</text></block><block wx:if="{{item.type==='field'}}"><view data-event-opts="{{[['tap',[['navigateTo',['$0'],[[['chatMessages','',index],['payload.items','',itemIndex,'path']]]]]]]}}" class="{{['card-item-field',(item.path)?'is-link':'']}}" bindtap="__e"><text class="field-label">{{item.label+":"}}</text><text class="field-value">{{item.value}}</text></view></block></view></block><block wx:if="{{msg.payload.qrCode}}"><image class="card-qrcode" src="{{msg.payload.qrCode}}" mode="widthFix"></image></block></view><block wx:if="{{msg.payload.footer}}"><view class="card-footer">{{msg.payload.footer}}</view></block><block wx:if="{{msg.payload.buttons}}"><view class="card-buttons"><block wx:for="{{msg.payload.buttons}}" wx:for-item="btn" wx:for-index="btnIndex" wx:key="btnIndex"><button data-event-opts="{{[['tap',[['handleCardButton',['$0'],[[['chatMessages','',index],['payload.buttons','',btnIndex]]]]]]]}}" class="card-button" bindtap="__e">{{btn.text}}</button></block></view></block></view></block><block wx:else><block wx:if="{{msg.type==='richContent'}}"><view class="rich-content-message"><block wx:if="{{msg.payload.title}}"><view class="rich-title">{{msg.payload.title}}</view></block><block wx:if="{{msg.payload.list&&msg.payload.displayType==='barChart'}}"><view class="bar-chart-container"><block wx:for="{{msg.payload.list}}" wx:for-item="item" wx:for-index="itemIndex" wx:key="itemIndex"><view data-event-opts="{{[['tap',[['navigateTo',['$0'],[[['chatMessages','',index],['payload.list','',itemIndex,'path']]]]]]]}}" class="bar-chart-item is-link" bindtap="__e"><view class="bar-label">{{item.label}}</view><view class="bar-wrapper"><view class="bar" style="{{'width:'+(item.value+'%')+';'+('background-color:'+(item.color)+';')}}"></view></view><view class="bar-text">{{item.text}}</view></view></block></view></block><block wx:else><block wx:if="{{msg.payload.list}}"><view class="rich-list"><block wx:for="{{msg.payload.list}}" wx:for-item="item" wx:for-index="itemIndex" wx:key="itemIndex"><view data-event-opts="{{[['tap',[['navigateTo',['$0'],[[['chatMessages','',index],['payload.list','',itemIndex,'path']]]]]]]}}" class="rich-list-item is-link" bindtap="__e">{{item.text}}</view></block></view></block></block><block wx:if="{{msg.payload.image}}"><image class="rich-image" src="{{msg.payload.image}}" mode="widthFix"></image></block><block wx:if="{{msg.payload.suggestion}}"><view class="rich-suggestion">{{msg.payload.suggestion}}</view></block></view></block><block wx:else><block wx:if="{{msg.type==='parcel'}}"><view class="parcel-message"><view class="parcel-title">{{msg.payload.title}}</view><block wx:for="{{msg.payload.parcels}}" wx:for-item="parcel" wx:for-index="pIndex" wx:key="pIndex"><view data-event-opts="{{[['tap',[['navigateTo',['$0'],[[['chatMessages','',index],['payload.parcels','',pIndex,'path']]]]]]]}}" class="parcel-item is-link" bindtap="__e"><view class="parcel-item-title">{{parcel.title}}</view><view class="parcel-info">{{"地点: "+parcel.location}}</view><view class="parcel-info">取件码:<text class="parcel-code">{{parcel.code}}</text></view></view></block></view></block><block wx:else><block wx:if="{{msg.type==='list'}}"><view class="list-message"><view class="list-title">{{msg.payload.title}}</view><block wx:for="{{msg.payload.items}}" wx:for-item="item" wx:for-index="itemIndex" wx:key="itemIndex"><view data-event-opts="{{[['tap',[['navigateTo',['$0'],[[['chatMessages','',index],['payload.items','',itemIndex,'path']]]]]]]}}" class="list-item is-link" bindtap="__e"><text>{{itemIndex+1+'.'}}</text><text>{{item.text}}</text></view></block></view></block></block></block></block></block></view></view></block><block wx:if="{{isTyping}}"><view class="chat-item assistant-message"><view class="avatar"><image src="{{botAvatar}}" mode="aspectFill"></image></view><view class="message-bubble"><view class="typing-indicator"><view class="dot"></view><view class="dot"></view><view class="dot"></view></view></view></view></block></view></scroll-view><block wx:if="{{$root.g0>0}}"><view class="task-panel"><text class="panel-title">进行中的任务</text><scroll-view class="task-scroll" scroll-x="true"><block wx:for="{{ongoingTasks}}" wx:for-item="task" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['viewTaskDetail',['$0'],[[['ongoingTasks','',index]]]]]]]}}" class="task-card" bindtap="__e"><view class="task-icon"><image src="{{task.icon}}" mode="aspectFit"></image></view><view class="task-info"><text class="task-title">{{task.title}}</text><text class="task-desc">{{task.description}}</text><view class="progress-bar"><view class="progress-fill" style="{{'width:'+(task.progress+'%')+';'}}"></view></view><text class="task-time">{{"剩余时间: "+task.remainingTime}}</text></view><view class="{{['task-status',task.status]}}"><text>{{task.statusText}}</text></view></view></block></scroll-view></view></block><view class="quick-access-menu"><scroll-view class="menu-scroll" scroll-x="true"><block wx:for="{{quickAccessItems}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['handleQuickAccess',['$0'],[[['quickAccessItems','',index]]]]]]]}}" class="menu-item" bindtap="__e"><view class="menu-icon"><image src="{{item.icon}}" mode="aspectFit"></image></view><text class="menu-text">{{item.text}}</text></view></block></scroll-view></view><view class="input-area"><input class="text-input" type="text" placeholder="问点什么..." data-event-opts="{{[['confirm',[['handleSendMessage',['$event']]]],['input',[['__set_model',['','inputMessage','$event',[]]]]]]}}" value="{{inputMessage}}" bindconfirm="__e" bindinput="__e"/><button class="send-btn" disabled="{{isTyping||!inputMessage}}" data-event-opts="{{[['tap',[['handleSendMessage',['$event']]]]]}}" bindtap="__e">发送</button></view></view>