代码示例：节流;

// 假定需要调用的是页面逻辑demoLogic

this.logicThrottle = throttle(this.demoLogic, 2000); // 节流，2000ms

function throttle(func, delay) {
    let inThrottle;
    return (...args) => {
        if (!inThrottle) {
            func(...args);
            inThrottle = true;
            setTimeout(() => (inThrottle = false), delay);
        }
    };
}
代码示例：防抖;

// 假定需要调用的是页面逻辑demoLogic

this.logicDebounce = debounce(this.demoLogic, 2000); // 防抖，2000ms

function debounce(func, delay) {
    let debounceTimer;
    return (...args) => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => func(...args), delay);
    };
}
逻辑调用。

